0x1080.jpg?t=1792002879"}], "movies": [{"name": "Launch trailer", "thumb": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257444012/dcf0b6ca3e5991596d8bbc52990a0a82ceecb19c/movie_600x337.jpg?t=1791993398", "mp4": ""}, {"name": "over the hill - Release Date Reveal Trailer", "thumb": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/257395664/51a0dd1e29f9e31399a1606cd8f23a93a29baf2d/movie_600x337.jpg?t=1786392947", "mp4": ""}], "price": {"final": 375.0, "orig": 469.0, "cur": "TWD", "pct": 20}, "reviews": {"label": "Very Positive", "pct": 93, "total": 619, "top": [{"text": "I play a lot of off-road and trucking games, and quite frankly, there aren't many games this year I would recommend more than Over the Hill.\n\nIt's one of those games where you set off towards something in the distance, g", "up": true, "hours": 17}, {"text": "For anyone that played the demo and was very let down by the poor optimization, I'm happy to say the game runs much better now!\n\nI haven't played a lot of it yet but the demo was fun other than poor performance.", "up": true, "hours": 1}, {"text": "immaculate vibes, great chill game for steamdeck, runs pretty well too", "up": true, "hours": 2}]}, "low": null, "fetched": "2026-10-15T07:14:02+00:00", "seen": "2026-10-15"}, "4968640": {"name": "Japanese Ramen Simulator", "desc": "《Japanese Ramen Simulator》是一款最多支援六人遊玩的拉麵店經營模擬遊戲。準備食材、煮麵、擺放配料，製作講究的一碗。開發原創菜色，自由設計廚房與用餐區。無論與朋友合作還是獨自經營，都朝理想中的人氣拉麵店邁進！", "metacritic": null, "shots": [{"t": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4968640/04c35f2452ab80a2cccd843d0a916656d18ab1de/ss_04c35f2452ab80a2cccd843d0a916656d18ab1de.600x338.jpg?t=1791626249", "f": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4968640/04c35f2452ab80a2cccd843d0a916656d18ab1de/ss_04c35f2452ab80a2cccd843d0a916656d18ab1de.1920x1080.jpg?t=1791626249"}, {"t": "https://shared.akamai.steamstatic.com/store_item_assets/steam/apps/4968640/8c8707d221ca63f1fc